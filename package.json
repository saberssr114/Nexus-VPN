{
  "name": "nexusvpn-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "NexusVPN desktop dashboard",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^36.3.2",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.nexusvpn.dashboard",
    "productName": "NexusVPN",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "*.js",
      "*.css",
      "electron/main.cjs"
    ],
    "win": {
      "target": ["nsis"],
      "artifactName": "NexusVPN-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}